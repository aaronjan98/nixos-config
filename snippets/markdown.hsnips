context math(context)
snippet `pa((?:[A-Za-z]{0,2})|(?:\\[a-zA-Z]+){1,2})` "partial derivative" A
``
const input = m[1];
if (input.includes("\\")) {
    const greekChars = input.match(/\\[a-zA-Z]+/g);
    if (greekChars.length === 2) {
        rv = `\\frac{\\partial ${greekChars[0]}}{\\partial ${greekChars[1]}}`;
    } else if (greekChars.length === 1) {
        rv = `\\frac{\\partial}{\\partial ${greekChars[0]}}`;
    }
} else if (input.length === 2) {
    rv = `\\frac{\\partial ${input[0]}}{\\partial ${input[1]}}`;
} else if (input.length === 1) {
    rv = `\\frac{\\partial}{\\partial ${input}}`;
} else {
    rv = "\\partial";
}
``
endsnippet

