snippet tayl "Taylor expansion" A
${0:f}(${1:x} + ${2:h}) = ${0:f}(${1:x}) + ${0:f}'(${1:x})${2:h} + ${0:f}''(${1:x}) \frac{${2:h}^{2}}{2!} + \dots$3
endsnippet

context math(context)
snippet `iden(\d)` "N x N identity matrix" A
``
const n = parseInt(m[1]);
let arr = [];
for (let j = 0; j < n; j++) {
    arr[j] = [];
    for (let i = 0; i < n; i++) {
        arr[j][i] = (i === j) ? 1 : 0;
    }
}
let output = arr.map(el => el.join(" & ")).join(" \\\\\n");
rv = `\\begin{pmatrix}\n${output}\n\\end{pmatrix}`;
``
endsnippet

context math(context)
snippet `arr_\{(\d+)\}x(\d+)` "Empty array with tab stops from arr_{rows}x_{cols} format" A
``
const rows = parseInt(m[1]);
const cols = parseInt(m[2]);
const colSpec = '|' + 'c|'.repeat(cols);
const tableRows = [];
let tabIndex = 1;
for (let i = 0; i < rows; i++) {
    const row = [];
    for (let j = 0; j < cols; j++) {
        row.push(tabIndex <= 9 ? `$${tabIndex++}` : ' ');
    }
    tableRows.push(row.join(' & '));
}
let output = `\\begin{array}{${colSpec}}\n\\hline\n${tableRows[0]} \\\\\n\\hline`;
for (let i = 1; i < rows; i++) {
    output += `\n${tableRows[i]} \\\\`;
}
output += `\n\\hline\n\\end{array}`;
rv = output;
``
endsnippet
