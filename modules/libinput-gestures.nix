{ pkgs, ... }:

# Supervise libinput-gestures (3-finger = switch browser/editor tab,
# 4-finger = switch workspace / workspace-domain).
#
# Previously enabled via a one-off `systemctl --user enable`, which writes an
# absolute-path symlink into ~/.config/systemd/user pointing at the package's
# current /nix/store path. A later rebuild that changed that store path (even
# via an unrelated input bump) left the symlink dangling and the service
# permanently dead with no visible error outside the journal — observed broken
# since 2026-09-05, unnoticed until swipe gestures stopped working. Declaring it
# here instead means the enable-symlink is regenerated by every activation, so
# it can't go stale.
#
# `After`/`WantedBy` target default.target, not graphical-session.target: the
# latter is never started on this Hyprland setup (see
# modules/hypr-session-autosave.nix and modules/hypr-monitor-watch.nix).
let
  # App-aware tab switch. Only known tabbed apps act; everything else is a
  # deliberate no-op so the gesture never fires a stray shortcut into a terminal
  # or spreadsheet. Keys differ per app: Firefox uses Ctrl+PageUp/PageDown;
  # Obsidian's next/prev-tab are remapped to Alt+L / Alt+H in the vault's
  # hotkeys.json (vim-style), so Ctrl+Page* does nothing there. Delivered via
  # `hyprctl dispatch sendshortcut`, which injects straight into the focused
  # window — so it bypasses kanata entirely and is unaffected by the home-row-mod
  # layout on the physical keyboards. Add a case for any other tabbed app.
  tabSwitch = pkgs.writeShellScriptBin "gesture-tab-switch" ''
    #!/usr/bin/env bash
    set -eu
    export PATH=/run/current-system/sw/bin:$PATH

    case "''${1:-}" in
      next|prev) dir="$1" ;;
      *) echo "usage: gesture-tab-switch next|prev" >&2; exit 2 ;;
    esac

    class="$(hyprctl activewindow -j \
      | ${pkgs.jq}/bin/jq -r '.class // empty' \
      | tr '[:upper:]' '[:lower:]')"

    case "$class" in
      *firefox*|*librewolf*|*zen*)
        next="CTRL, Next"; prev="CTRL, Prior" ;;   # Ctrl+PageDown / Ctrl+PageUp
      *obsidian*)
        next="ALT, L";     prev="ALT, H" ;;        # vault hotkeys.json (vim)
      *)
        exit 0 ;;                                   # not a known tabbed app
    esac

    if [ "$dir" = next ]; then combo="$next"; else combo="$prev"; fi
    hyprctl dispatch sendshortcut "$combo, activewindow"
  '';
in
{
  # Gesture bindings, declared here instead of a loose ~/.config/
  # libinput-gestures.conf that only Syncthing kept in step between hosts. The
  # service below is pointed at this file with `-c`, so the per-user copy (if one
  # still exists) is ignored and both machines get byte-identical gestures.
  environment.etc."libinput-gestures.conf".text = ''
    # Watch ALL touchpads, not just the first auto-detected one. Without this,
    # libinput-gestures binds to a single device (the internal PIXA3854
    # touchpad) and ignores external ones like the Apple Magic Trackpad.
    device all

    # 3-finger (ANY direction) = switch tab. up/left = next, down/right = prev.
    # Both axes bound so it works whatever the tab orientation is (Firefox has
    # vertical tabs, Obsidian horizontal). App-specific keys via gesture-tab-switch
    # above; a no-op in apps without tabs.
    gesture swipe up    3  ${tabSwitch}/bin/gesture-tab-switch next
    gesture swipe left  3  ${tabSwitch}/bin/gesture-tab-switch next
    gesture swipe down  3  ${tabSwitch}/bin/gesture-tab-switch prev
    gesture swipe right 3  ${tabSwitch}/bin/gesture-tab-switch prev

    # 4-finger: move between workspaces (left/right) and workspace domains
    # (up/down). Scripts live in aj's Hyprland dotfiles. "Content-drag" direction
    # (swipe the strip the way you'd push paper): swipe left -> next workspace,
    # swipe up -> next domain (down the stack); reverse for the other way.
    gesture swipe left  4  /home/aj/.config/hypr/scripts/ws-rel +1
    gesture swipe right 4  /home/aj/.config/hypr/scripts/ws-rel -1
    gesture swipe up    4  /home/aj/.config/hypr/scripts/ws-domain down
    gesture swipe down  4  /home/aj/.config/hypr/scripts/ws-domain up
  '';

  systemd.user.services.libinput-gestures = {
    description = "Actions gestures on your touchpad using libinput";
    after = [ "default.target" ];
    wantedBy = [ "default.target" ];
    serviceConfig = {
      Type = "simple";
      ExecStart = "${pkgs.libinput-gestures}/bin/libinput-gestures -c /etc/libinput-gestures.conf";
      Environment = "PATH=/run/current-system/sw/bin:/etc/profiles/per-user/%u/bin";
      Restart = "on-failure";
      RestartSec = "5s";
    };
  };
}
